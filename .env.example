# Databricks SQL warehouse connection (copy to .env and fill in values)
DBT_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DBT_DATABRICKS_TOKEN=your-personal-access-token
DBT_DATABRICKS_SCHEMA=silver
DBT_DATABRICKS_CATALOG=dev
DBT_RAW_SCHEMA=bronze

# dbt platform token (VS Code extension / dbt Cloud)
DBT_TOKEN=your-dbt-user-token
